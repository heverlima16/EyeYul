<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    EyeYul solo usa paquetes publicos. Se limpian las fuentes heredadas
    (incluido el feed privado de Azure Artifacts, que exige autenticacion)
    para que restaurar funcione en cualquier maquina.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
