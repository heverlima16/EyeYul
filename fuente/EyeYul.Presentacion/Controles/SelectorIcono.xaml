<UserControl x:Class="EyeYul.Presentacion.Controles.SelectorIcono"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:EyeYul.Presentacion">
    <!-- Boton que muestra el icono elegido y despliega una grilla de iconos para elegir otro. -->
    <UserControl.Resources>
        <app:IconKeyToGeometryConverter x:Key="IconKeyToGeometry" />
    </UserControl.Resources>
    <Grid>
        <Button x:Name="BotonPrincipal" Click="OnAbrirClick" Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Path x:Name="IconoActual" Style="{StaticResource Ico}" Width="16" Height="16" Stroke="{DynamicResource AccentBrush}" />
        </Button>

        <Popup x:Name="Desplegable" PlacementTarget="{Binding ElementName=BotonPrincipal}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Width="176" Margin="0,4,0,0" Padding="6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" Color="#000000" />
                </Border.Effect>
                <ItemsControl x:Name="Lista">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="OnItemClick" Width="30" Height="30" Margin="2" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Fondo" Background="Transparent" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Path Style="{StaticResource Ico}" Width="15" Height="15" Stroke="{DynamicResource InkBrush}"
                                      Data="{Binding Converter={StaticResource IconKeyToGeometry}}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>
    </Grid>
</UserControl>
