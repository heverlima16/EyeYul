<UserControl x:Class="EyeYul.Presentacion.Controles.AnilloProgreso"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="210" Height="210">
    <Grid>
        <Ellipse Width="196" Height="196" StrokeThickness="14"
                 Stroke="{DynamicResource CardBorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Path x:Name="Arc" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Stroke="{DynamicResource AccentBrush}" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="CenterLabel" Text="20:00" FontSize="42" FontWeight="Bold"
                       Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center"
                       FontFamily="{StaticResource SansFont}" />
            <TextBlock x:Name="SubLabel" Text="Próxima Pausa" FontSize="10"
                       FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource SubBrush}"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>

