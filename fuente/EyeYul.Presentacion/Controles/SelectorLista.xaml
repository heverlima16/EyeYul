<UserControl x:Class="EyeYul.Presentacion.Controles.SelectorLista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Raiz">
    <!-- Selector estilo "dropdown de Google Calendar": un TextBox donde se puede
         digitar CUALQUIER valor, mas una flecha que despliega una lista de atajos
         comunes para elegir mas rapido. No es un ComboBox nativo (se pinta claro
         en tema oscuro si no se re-templa por completo).

         El TextBox se ata a Seleccionado con un binding real de WPF (ElementName)
         en vez de sincronizar a mano con TextChanged + un callback de DP: esa
         sincronizacion manual tenia una condicion de carrera que dejaba el campo
         vacio la primera vez que se abria la ventana. -->
    <Grid x:Name="BotonPrincipal">
        <TextBox x:Name="Etiqueta" FontSize="12" Padding="8,7,28,7"
                 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
                 Text="{Binding Seleccionado, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Button Click="OnAbrirClick" Cursor="Hand" Width="26" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Path Data="M0,0 L5,5 10,0" Stroke="{DynamicResource SubBrush}" StrokeThickness="1.4" Width="10" Height="5" Stretch="Uniform" />
        </Button>

        <Popup x:Name="Desplegable" PlacementTarget="{Binding ElementName=BotonPrincipal}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="10" MaxHeight="220" MinWidth="110" Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" Color="#000000" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <ItemsControl x:Name="Lista">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OnItemClick" Padding="10,7" Cursor="Hand"
                                        HorizontalContentAlignment="Left" HorizontalAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Fondo" Background="Transparent" CornerRadius="6">
                                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource InkBrush}" FontSize="12" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
