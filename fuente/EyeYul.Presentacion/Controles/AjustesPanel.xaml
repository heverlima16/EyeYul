<UserControl x:Class="EyeYul.Presentacion.Controles.AjustesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EyeYul.Presentacion.Controles"
             FontFamily="{DynamicResource SansFont}" TextOptions.TextFormattingMode="Display">
    <!-- Contenido de Ajustes extraido a UserControl para reusarse tanto en la ventana
         flotante independiente (accesible desde la bandeja aunque la ventana principal
         este cerrada) como en el modal embebido de VentanaPrincipal. -->
    <UserControl.Resources>
        <Style x:Key="CampoNumerico" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="90" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="MaxLength" Value="4" />
            <!-- Marca el campo para que el filtro de pegado lo reconozca. -->
            <Setter Property="Tag" Value="numerico" />
        </Style>
    </UserControl.Resources>

    <Grid Width="460" MaxHeight="600">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,16">
            <Image Source="{StaticResource EyeLogo}" Width="36" Height="36" />
            <TextBlock Text="Ajustes" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <TextBlock Text="PAUSAS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,8" />

                <TextBlock Text="Intervalo entre pausas" Foreground="{DynamicResource InkBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                    <c:SelectorLista ItemsSource="{Binding IntervalosDisponibles}" Seleccionado="{Binding IntervalMinutesText, Mode=TwoWay}" Width="90" Height="34" />
                    <TextBlock Text="minutos · entre 1 y 120 (digita cualquier valor)" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>

                <TextBlock Text="Duración de la pausa" Foreground="{DynamicResource InkBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                    <c:SelectorLista ItemsSource="{Binding DuracionesDisponibles}" Seleccionado="{Binding DurationSecondsText, Mode=TwoWay}" Width="90" Height="34" />
                    <TextBlock Text="segundos · entre 5 y 600 (digita cualquier valor)" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>

                <TextBlock Text="Mensaje de la pausa" Foreground="{DynamicResource InkBrush}" />
                <TextBox Text="{Binding BreakMessage}" Margin="0,6,0,16" Padding="8" TextWrapping="Wrap" MinHeight="48" />

                <TextBlock Text="PAUSA INTELIGENTE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,8" />
                <CheckBox Content="Respetar el flujo (pausa inteligente)" IsChecked="{Binding SmartPauseEnabled}" Margin="0,4" Foreground="{DynamicResource InkBrush}" />
                <CheckBox Content="No interrumpir en pantalla completa" IsChecked="{Binding RespectFullscreen}" Margin="0,4" Foreground="{DynamicResource InkBrush}" />
                <CheckBox Content="No interrumpir en reuniones (mic/cámara)" IsChecked="{Binding RespectMeetings}" Margin="0,4" Foreground="{DynamicResource InkBrush}" />
                <CheckBox Content="No interrumpir al reproducir video" IsChecked="{Binding RespectMedia}" Margin="0,4,0,14" Foreground="{DynamicResource InkBrush}" />

                <TextBlock Text="Máx. aplazamientos por día" Foreground="{DynamicResource InkBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                    <TextBox Style="{StaticResource CampoNumerico}"
                             Text="{Binding MaxSnoozesPerDay}"
                             PreviewTextInput="SoloDigitos" />
                    <TextBlock Text="0 = sin límite" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>

                <TextBlock Text="GENERAL" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,8" />
                <CheckBox Content="Iniciar con Windows" IsChecked="{Binding StartWithWindows}" Margin="0,4" Foreground="{DynamicResource InkBrush}" />
                <CheckBox Content="Reproducir sonido en la pausa" IsChecked="{Binding PlaySound}" Margin="0,4" Foreground="{DynamicResource InkBrush}" />
                <CheckBox Content="Mostrar countdown flotante" IsChecked="{Binding ShowFloatingCountdown}" Margin="0,4,0,14" Foreground="{DynamicResource InkBrush}" />

                <TextBlock Text="COPIA DE SEGURIDAD" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,8" />
                <TextBlock Text="Guarda tu configuración en un archivo .yul o restaura una copia anterior." TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Exportar copia" Style="{StaticResource GhostButton}" Command="{Binding ExportarRespaldoCommand}" />
                    <Button Content="Importar copia" Style="{StaticResource GhostButton}" Command="{Binding ImportarRespaldoCommand}" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
