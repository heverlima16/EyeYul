<UserControl x:Class="EyeYul.Presentacion.Controles.SelectorFecha"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Calendario propio (boton + Popup con grilla de dias). Se construye a mano en vez de
         usar el DatePicker/Calendar nativos de WPF: retemplarlos por completo para que no se
         vean claros en tema oscuro es mucho mas trabajo que dibujar la grilla nosotros mismos. -->
    <Grid>
        <Button x:Name="BotonPrincipal" Click="OnAbrirClick" Cursor="Hand" HorizontalContentAlignment="Stretch">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <ContentPresenter Margin="8,7" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <DockPanel>
                <Path DockPanel.Dock="Left" Data="M2,1 L2,3 M8,1 L8,3 M1,4 L9,4 M1,2 L1,9 L9,9 L9,2 Z"
                      Stroke="{DynamicResource SubBrush}" StrokeThickness="1" Width="13" Height="13"
                      Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBlock x:Name="Etiqueta" Foreground="{DynamicResource InkBrush}" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
        </Button>

        <Popup x:Name="Desplegable" PlacementTarget="{Binding ElementName=BotonPrincipal}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Width="240" Margin="0,4,0,0" Padding="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Content="‹" Click="OnMesAnteriorClick" Width="26" Height="26"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="14" Foreground="{DynamicResource InkBrush}" />
                        <Button DockPanel.Dock="Right" Content="›" Click="OnMesSiguienteClick" Width="26" Height="26"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="14" Foreground="{DynamicResource InkBrush}" />
                        <TextBlock x:Name="TituloMes" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                    <UniformGrid Columns="7" Margin="0,0,0,4">
                        <TextBlock Text="L" HorizontalAlignment="Center" FontSize="9" Foreground="{DynamicResource SubBrush}" />
                        <TextBlock Text="M" HorizontalAlignment="Center" FontSize="9" Foreground="{DynamicResource SubBrush}" />
                        <TextBlock Text="X" HorizontalAlignment="Center" FontSize="9" Foreground="{DynamicResource SubBrush}" />
                        <TextBlock Text="J" HorizontalAlignment="Center" FontSize="9" Foreground="{DynamicResource SubBrush}" />
                        <TextBlock Text="V" HorizontalAlignment="Center" FontSize="9" Foreground="{DynamicResource SubBrush}" />
                        <TextBlock Text="S" HorizontalAlignment="Center" FontSize="9" Foreground="{DynamicResource SubBrush}" />
                        <TextBlock Text="D" HorizontalAlignment="Center" FontSize="9" Foreground="{DynamicResource SubBrush}" />
                    </UniformGrid>
                    <UniformGrid x:Name="Dias" Columns="7" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
