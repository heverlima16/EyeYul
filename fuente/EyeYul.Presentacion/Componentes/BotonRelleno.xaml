<UserControl x:Class="EyeYul.Presentacion.Componentes.BotonRelleno"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="150">
    <Button Command="{Binding Comando, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="{Binding ParametroComando, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Style="{StaticResource PrimaryButton}"
            Content="{Binding Texto, RelativeSource={RelativeSource AncestorType=UserControl}}" />
</UserControl>
