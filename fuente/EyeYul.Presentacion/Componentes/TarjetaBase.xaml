<UserControl x:Class="EyeYul.Presentacion.Componentes.TarjetaBase"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="150" d:DesignWidth="300">
    <!-- El marco de la tarjeta se define como ControlTemplate (y no como contenido del
         UserControl) por dos razones:
         1. Si fuera contenido, al escribir <comp:TarjetaBase>...</comp:TarjetaBase> el
            consumidor REEMPLAZA ese contenido y el marco desaparece (gotcha de WPF).
            Con template, el ContentPresenter muestra el contenido del consumidor dentro
            del marco, que queda intacto.
         2. La sombra vive en un Border vacío DETRÁS del contenido. Si el DropShadowEffect
            envolviera al contenido, WPF rasterizaría cada tarjeta completa en una
            superficie intermedia (RAM) y recalcularía la sombra en cada repintado. -->
    <UserControl.Template>
        <ControlTemplate TargetType="UserControl">
            <Grid>
                <!-- Solo la sombra: mismo tamaño y radio que la tarjeta, sin contenido. -->
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.04" Color="#000" />
                    </Border.Effect>
                </Border>

                <!-- La tarjeta real, sin efecto, con el contenido del consumidor dentro. -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="12"
                        Padding="18"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1">
                    <ContentPresenter />
                </Border>
            </Grid>
        </ControlTemplate>
    </UserControl.Template>
</UserControl>
