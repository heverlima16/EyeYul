<Application x:Class="EyeYul.Presentacion.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Temas/Palette.xaml" />
                <ResourceDictionary Source="Temas/Icons.xaml" />
                <ResourceDictionary Source="Temas/Controles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- El rectángulo punteado de foco por teclado de WPF es cuadrado y no respeta
                 el CornerRadius de ningún botón de la app: se ve como una esquina rota
                 sobre los botones redondeados. Sin estilo propio, ningún botón lo dibuja. -->
            <Style TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
