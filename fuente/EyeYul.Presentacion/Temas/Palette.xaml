<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib">
    <Color x:Key="MutedColor">#FF94A3B8</Color>
    <Color x:Key="TerracottaDarkColor">#FFEA580C</Color>
    <Color x:Key="AccentColor">#FFF97316</Color>
    <Color x:Key="GreenColor">#FF10B981</Color>
    <Color x:Key="AccentSoftColor">#FFFFF1E8</Color>
    <Style TargetType="Button" x:Key="GhostButton">
        <Style.Resources>
            <ResourceDictionary />
        </Style.Resources>
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Panel.Background">
            <Setter.Value>
                <DynamicResource ResourceKey="SurfaceAltBrush" />
            </Setter.Value>
        </Setter>
        <Setter Property="TextElement.Foreground">
            <Setter.Value>
                <DynamicResource ResourceKey="InkBrush" />
            </Setter.Value>
        </Setter>
        <Setter Property="TextElement.FontSize">
            <Setter.Value>
                <s:Double>12</s:Double>
            </Setter.Value>
        </Setter>
        <Setter Property="TextElement.FontWeight">
            <Setter.Value>
                <FontWeight>Bold</FontWeight>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.Padding">
            <Setter.Value>
                <Thickness>14,9,14,9</Thickness>
            </Setter.Value>
        </Setter>
        <Setter Property="FrameworkElement.Cursor">
            <Setter.Value>
                <Cursor>Hand</Cursor>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border BorderThickness="1,1,1,1" Padding="{TemplateBinding Control.Padding}" CornerRadius="12,12,12,12" BorderBrush="{DynamicResource CardBorderBrush}" Background="{TemplateBinding Panel.Background}" Name="b">
                        <ContentPresenter Content="{TemplateBinding ContentControl.Content}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver">
                            <Setter Property="Panel.Background" TargetName="b">
                                <Setter.Value>
                                    <DynamicResource ResourceKey="CardBorderBrush" />
                                </Setter.Value>
                            </Setter>
                            <Trigger.Value>
                                <s:Boolean>True</s:Boolean>
                            </Trigger.Value>
                        </Trigger>
                        <!-- Reemplaza al rectangulo punteado por defecto de WPF (que se quitó
                             globalmente en App.xaml por no respetar esquinas redondeadas):
                             sin esto, navegar con Tab no mostraba nada. -->
                        <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                            <Setter Property="Border.BorderBrush" TargetName="b" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Border.BorderThickness" TargetName="b" Value="2,2,2,2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Color x:Key="TerracottaColor">#FFF97316</Color>
    <SolidColorBrush x:Key="InkBrush">#FF0F172A</SolidColorBrush>
    <Color x:Key="SubColor">#FF64748B</Color>
    <Color x:Key="SidebarColor">#FFF1F5F9</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="AmberBrush">#FFF59E0B</SolidColorBrush>
    <Color x:Key="AmberColor">#FFF59E0B</Color>
    <SolidColorBrush x:Key="SurfaceBrush">#FFFFFFFF</SolidColorBrush>
    <Color x:Key="Accent50Color">#FFFFF1E8</Color>
    <Color x:Key="AccentStrongColor">#FFEA580C</Color>
    <Color x:Key="BlueColor">#FF3B82F6</Color>
    <SolidColorBrush x:Key="AccentStrongBrush">#FFEA580C</SolidColorBrush>
    <Color x:Key="CardBorderColor">#FFE2E8F0</Color>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>
    <SolidColorBrush x:Key="CardBorderBrush">#FFE2E8F0</SolidColorBrush>
    <Color x:Key="OverlayTopColor">#FFF97316</Color>
    <SolidColorBrush x:Key="TerracottaBrush">#FFF97316</SolidColorBrush>
    <Style TargetType="Border" x:Key="Card">
        <Style.Resources>
            <ResourceDictionary />
        </Style.Resources>
        <Setter Property="Panel.Background">
            <Setter.Value>
                <DynamicResource ResourceKey="SurfaceBrush" />
            </Setter.Value>
        </Setter>
        <Setter Property="Border.BorderBrush">
            <Setter.Value>
                <DynamicResource ResourceKey="CardBorderBrush" />
            </Setter.Value>
        </Setter>
        <Setter Property="Border.BorderThickness">
            <Setter.Value>
                <Thickness>1,1,1,1</Thickness>
            </Setter.Value>
        </Setter>
        <Setter Property="Border.CornerRadius">
            <Setter.Value>
                <CornerRadius>16,16,16,16</CornerRadius>
            </Setter.Value>
        </Setter>
        <Setter Property="Border.Padding">
            <Setter.Value>
                <Thickness>16,16,16,16</Thickness>
            </Setter.Value>
        </Setter>
    </Style>
    <FontFamily x:Key="SansFont">Segoe UI</FontFamily>
    <SolidColorBrush x:Key="PanelBrush">#FFF8FAFC</SolidColorBrush>
    <SolidColorBrush x:Key="SubBrush">#FF64748B</SolidColorBrush>
    <Color x:Key="InkColor">#FF0F172A</Color>
    <SolidColorBrush x:Key="SidebarBrush">#FFF1F5F9</SolidColorBrush>
    <SolidColorBrush x:Key="BorderBrush">#FFE2E8F0</SolidColorBrush>
    <SolidColorBrush x:Key="CreamBrush">#FFF8FAFC</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#FFF97316</SolidColorBrush>
    <!-- Logo oficial (zanahoria), reemplaza al dibujo vectorial hecho a mano. Se mantiene
         la misma clave EyeLogo para no tocar los ~5 lugares que ya la consumen. -->
    <BitmapImage x:Key="EyeLogo" UriSource="pack://application:,,,/EyeYul;component/Recursos/carrot-logo.png" />
    <Color x:Key="BorderColor">#FFE2E8F0</Color>
    <SolidColorBrush x:Key="TerracottaDarkBrush">#FFEA580C</SolidColorBrush>
    <Color x:Key="OverlayBottomColor">#FFEA580C</Color>
    <SolidColorBrush x:Key="GreenBrush">#FF10B981</SolidColorBrush>
    <SolidColorBrush x:Key="AccentSoftBrush">#26F97316</SolidColorBrush>
    <SolidColorBrush x:Key="MutedBrush">#FF94A3B8</SolidColorBrush>
    <!-- Fondo oscurecido detras de los modales embebidos (Ajustes, Licencia). -->
    <SolidColorBrush x:Key="OverlayBrush">#99000000</SolidColorBrush>
    <Color x:Key="SurfaceAltColor">#FFF1F5F9</Color>
    <Color x:Key="CreamColor">#FFF8FAFC</Color>
    <Color x:Key="PanelColor">#FFF8FAFC</Color>
    <SolidColorBrush x:Key="SurfaceAltBrush">#FFF1F5F9</SolidColorBrush>
    <Style TargetType="Button" x:Key="PrimaryButton">
        <Style.Resources>
            <ResourceDictionary />
        </Style.Resources>
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Panel.Background">
            <Setter.Value>
                <SolidColorBrush>#FFF97316</SolidColorBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="TextElement.Foreground">
            <Setter.Value>
                <SolidColorBrush>#FFFFFFFF</SolidColorBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="TextElement.FontSize">
            <Setter.Value>
                <s:Double>12</s:Double>
            </Setter.Value>
        </Setter>
        <Setter Property="TextElement.FontWeight">
            <Setter.Value>
                <FontWeight>Bold</FontWeight>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.Padding">
            <Setter.Value>
                <Thickness>16,9,16,9</Thickness>
            </Setter.Value>
        </Setter>
        <Setter Property="FrameworkElement.Cursor">
            <Setter.Value>
                <Cursor>Hand</Cursor>
            </Setter.Value>
        </Setter>
        <Setter Property="Border.BorderThickness">
            <Setter.Value>
                <Thickness>0,0,0,0</Thickness>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Padding="{TemplateBinding Control.Padding}" CornerRadius="12,12,12,12" Background="{TemplateBinding Panel.Background}"
                            BorderThickness="2,2,2,2" BorderBrush="Transparent" Name="b">
                        <ContentPresenter Content="{TemplateBinding ContentControl.Content}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver">
                            <Setter Property="Panel.Background" TargetName="b">
                                <Setter.Value>
                                    <SolidColorBrush>#FFEA580C</SolidColorBrush>
                                </Setter.Value>
                            </Setter>
                            <Trigger.Value>
                                <s:Boolean>True</s:Boolean>
                            </Trigger.Value>
                        </Trigger>
                        <!-- Reemplaza al rectangulo punteado por defecto de WPF (quitado
                             globalmente en App.xaml). Blanco porque el fondo ya es el acento
                             naranja: un aro del mismo acento no se vería. -->
                        <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                            <Setter Property="Border.BorderBrush" TargetName="b" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <SolidColorBrush x:Key="BlueBrush">#FF3B82F6</SolidColorBrush>

    <!-- Pill de estado tipo badge ("En Vivo", "96 pts"): el llamador setea
         Background/BorderBrush/Foreground localmente (color semantico), el
         estilo solo aporta la forma capsula + tipografia mono chica. -->
    <Style x:Key="PillBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="PillBadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Boton primario en degradado naranja-ambar (timer, "Descansar Ya"): mismo
         template que PrimaryButton pero con AccentGradientBrush de fondo. -->
    <Style TargetType="Button" x:Key="PrimaryGradientButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Panel.Background" Value="{DynamicResource AccentGradientBrush}" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Padding="{TemplateBinding Control.Padding}" CornerRadius="12,12,12,12" Background="{TemplateBinding Panel.Background}"
                            BorderThickness="2,2,2,2" BorderBrush="Transparent" Name="b" Opacity="1">
                        <ContentPresenter Content="{TemplateBinding ContentControl.Content}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                            <Setter Property="UIElement.Opacity" TargetName="b" Value="0.88" />
                        </Trigger>
                        <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                            <Setter Property="Border.BorderBrush" TargetName="b" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Semanticos nuevos del mockup "obsidiana" (badges de sidebar/tarjetas): invariantes
         de marca, mismo valor en Palette.xaml y PaletteDark.xaml, TemaAplicador no los toca. -->
    <SolidColorBrush x:Key="IndigoBrush">#FF6366F1</SolidColorBrush>
    <SolidColorBrush x:Key="SkyBrush">#FF0EA5E9</SolidColorBrush>
    <SolidColorBrush x:Key="RoseBrush">#FFF43F5E</SolidColorBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F97316" Offset="0" />
        <GradientStop Color="#F59E0B" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
