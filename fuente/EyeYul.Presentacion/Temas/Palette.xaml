<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib">
    <Color x:Key="MutedColor">#FF9CA3AF</Color>
    <Color x:Key="TerracottaDarkColor">#FFCB5B3E</Color>
    <Color x:Key="AccentColor">#FFDE7356</Color>
    <Color x:Key="GreenColor">#FF10B981</Color>
    <Color x:Key="AccentSoftColor">#FFFBEBE5</Color>
    <Style TargetType="Button" x:Key="GhostButton">
        <Style.Resources>
            <ResourceDictionary />
        </Style.Resources>
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Panel.Background">
            <Setter.Value>
                <DynamicResource ResourceKey="SurfaceAltBrush" />
            </Setter.Value>
        </Setter>
        <Setter Property="TextElement.Foreground">
            <Setter.Value>
                <DynamicResource ResourceKey="InkBrush" />
            </Setter.Value>
        </Setter>
        <Setter Property="TextElement.FontSize">
            <Setter.Value>
                <s:Double>12</s:Double>
            </Setter.Value>
        </Setter>
        <Setter Property="TextElement.FontWeight">
            <Setter.Value>
                <FontWeight>Bold</FontWeight>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.Padding">
            <Setter.Value>
                <Thickness>14,9,14,9</Thickness>
            </Setter.Value>
        </Setter>
        <Setter Property="FrameworkElement.Cursor">
            <Setter.Value>
                <Cursor>Hand</Cursor>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border BorderThickness="1,1,1,1" Padding="{TemplateBinding Control.Padding}" CornerRadius="10,10,10,10" BorderBrush="{DynamicResource CardBorderBrush}" Background="{TemplateBinding Panel.Background}" Name="b">
                        <ContentPresenter Content="{TemplateBinding ContentControl.Content}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver">
                            <Setter Property="Panel.Background" TargetName="b">
                                <Setter.Value>
                                    <DynamicResource ResourceKey="CardBorderBrush" />
                                </Setter.Value>
                            </Setter>
                            <Trigger.Value>
                                <s:Boolean>True</s:Boolean>
                            </Trigger.Value>
                        </Trigger>
                        <!-- Reemplaza al rectangulo punteado por defecto de WPF (que se quitó
                             globalmente en App.xaml por no respetar esquinas redondeadas):
                             sin esto, navegar con Tab no mostraba nada. -->
                        <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                            <Setter Property="Border.BorderBrush" TargetName="b" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Border.BorderThickness" TargetName="b" Value="2,2,2,2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Color x:Key="TerracottaColor">#FFDE7356</Color>
    <SolidColorBrush x:Key="InkBrush">#FF111827</SolidColorBrush>
    <Color x:Key="SubColor">#FF6B7280</Color>
    <Color x:Key="SidebarColor">#FFF3E6D3</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="AmberBrush">#FFF59E0B</SolidColorBrush>
    <Color x:Key="AmberColor">#FFF59E0B</Color>
    <SolidColorBrush x:Key="SurfaceBrush">#FFFFFFFF</SolidColorBrush>
    <Color x:Key="Accent50Color">#FFFDF5F2</Color>
    <Color x:Key="AccentStrongColor">#FFCB5B3E</Color>
    <Color x:Key="BlueColor">#FF3B82F6</Color>
    <SolidColorBrush x:Key="AccentStrongBrush">#FFCB5B3E</SolidColorBrush>
    <Color x:Key="CardBorderColor">#FFE5E7EB</Color>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>
    <SolidColorBrush x:Key="CardBorderBrush">#FFE5E7EB</SolidColorBrush>
    <Color x:Key="OverlayTopColor">#FFDE7356</Color>
    <SolidColorBrush x:Key="TerracottaBrush">#FFDE7356</SolidColorBrush>
    <Style TargetType="Border" x:Key="Card">
        <Style.Resources>
            <ResourceDictionary />
        </Style.Resources>
        <Setter Property="Panel.Background">
            <Setter.Value>
                <DynamicResource ResourceKey="SurfaceBrush" />
            </Setter.Value>
        </Setter>
        <Setter Property="Border.BorderBrush">
            <Setter.Value>
                <DynamicResource ResourceKey="CardBorderBrush" />
            </Setter.Value>
        </Setter>
        <Setter Property="Border.BorderThickness">
            <Setter.Value>
                <Thickness>1,1,1,1</Thickness>
            </Setter.Value>
        </Setter>
        <Setter Property="Border.CornerRadius">
            <Setter.Value>
                <CornerRadius>14,14,14,14</CornerRadius>
            </Setter.Value>
        </Setter>
        <Setter Property="Border.Padding">
            <Setter.Value>
                <Thickness>16,16,16,16</Thickness>
            </Setter.Value>
        </Setter>
    </Style>
    <FontFamily x:Key="SansFont">Segoe UI</FontFamily>
    <SolidColorBrush x:Key="PanelBrush">#FFFAF9F6</SolidColorBrush>
    <SolidColorBrush x:Key="SubBrush">#FF6B7280</SolidColorBrush>
    <Color x:Key="InkColor">#FF111827</Color>
    <SolidColorBrush x:Key="SidebarBrush">#FFF3E6D3</SolidColorBrush>
    <SolidColorBrush x:Key="BorderBrush">#FFE5E7EB</SolidColorBrush>
    <SolidColorBrush x:Key="CreamBrush">#FFFAF9F6</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#FFDE7356</SolidColorBrush>
    <!-- Logo oficial (zanahoria), reemplaza al dibujo vectorial hecho a mano. Se mantiene
         la misma clave EyeLogo para no tocar los ~5 lugares que ya la consumen. -->
    <BitmapImage x:Key="EyeLogo" UriSource="pack://application:,,,/EyeYul;component/Recursos/carrot-logo.png" />
    <Color x:Key="BorderColor">#FFE5E7EB</Color>
    <SolidColorBrush x:Key="TerracottaDarkBrush">#FFCB5B3E</SolidColorBrush>
    <Color x:Key="OverlayBottomColor">#FF8C3C2A</Color>
    <SolidColorBrush x:Key="GreenBrush">#FF10B981</SolidColorBrush>
    <SolidColorBrush x:Key="AccentSoftBrush">#FFFBEBE5</SolidColorBrush>
    <SolidColorBrush x:Key="MutedBrush">#FF9CA3AF</SolidColorBrush>
    <!-- Fondo oscurecido detras de los modales embebidos (Ajustes, Licencia). -->
    <SolidColorBrush x:Key="OverlayBrush">#99000000</SolidColorBrush>
    <Color x:Key="SurfaceAltColor">#FFF9FAFB</Color>
    <Color x:Key="CreamColor">#FFFAF9F6</Color>
    <Color x:Key="PanelColor">#FFFAF9F6</Color>
    <SolidColorBrush x:Key="SurfaceAltBrush">#FFF9FAFB</SolidColorBrush>
    <Style TargetType="Button" x:Key="PrimaryButton">
        <Style.Resources>
            <ResourceDictionary />
        </Style.Resources>
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Panel.Background">
            <Setter.Value>
                <SolidColorBrush>#FFDE7356</SolidColorBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="TextElement.Foreground">
            <Setter.Value>
                <SolidColorBrush>#FFFFFFFF</SolidColorBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="TextElement.FontSize">
            <Setter.Value>
                <s:Double>12</s:Double>
            </Setter.Value>
        </Setter>
        <Setter Property="TextElement.FontWeight">
            <Setter.Value>
                <FontWeight>Bold</FontWeight>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.Padding">
            <Setter.Value>
                <Thickness>16,9,16,9</Thickness>
            </Setter.Value>
        </Setter>
        <Setter Property="FrameworkElement.Cursor">
            <Setter.Value>
                <Cursor>Hand</Cursor>
            </Setter.Value>
        </Setter>
        <Setter Property="Border.BorderThickness">
            <Setter.Value>
                <Thickness>0,0,0,0</Thickness>
            </Setter.Value>
        </Setter>
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Padding="{TemplateBinding Control.Padding}" CornerRadius="10,10,10,10" Background="{TemplateBinding Panel.Background}"
                            BorderThickness="2,2,2,2" BorderBrush="Transparent" Name="b">
                        <ContentPresenter Content="{TemplateBinding ContentControl.Content}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver">
                            <Setter Property="Panel.Background" TargetName="b">
                                <Setter.Value>
                                    <SolidColorBrush>#FFCB5B3E</SolidColorBrush>
                                </Setter.Value>
                            </Setter>
                            <Trigger.Value>
                                <s:Boolean>True</s:Boolean>
                            </Trigger.Value>
                        </Trigger>
                        <!-- Reemplaza al rectangulo punteado por defecto de WPF (quitado
                             globalmente en App.xaml). Blanco porque el fondo ya es el acento
                             naranja: un aro del mismo acento no se vería. -->
                        <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                            <Setter Property="Border.BorderBrush" TargetName="b" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <SolidColorBrush x:Key="BlueBrush">#FF3B82F6</SolidColorBrush>
</ResourceDictionary>