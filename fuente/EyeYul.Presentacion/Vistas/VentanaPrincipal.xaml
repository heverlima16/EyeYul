<Window x:Class="EyeYul.Presentacion.Vistas.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:EyeYul.Presentacion"
        xmlns:c="clr-namespace:EyeYul.Presentacion.Controles"
        xmlns:comp="clr-namespace:EyeYul.Presentacion.Componentes"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="EyeYul" Width="1180" Height="770" MinWidth="1000" MinHeight="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Icon="pack://application:,,,/EyeYul;component/app.ico"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource SansFont}"
        TextOptions.TextFormattingMode="Display">

    <!-- Chrome nativo propio: sin esto (WindowStyle=None + AllowsTransparency=True) WPF no da
         NINGUN borde para redimensionar arrastrando ni Aero-snap. CaptionHeight cubre la franja
         superior de 32px (ahí ya vive el DragMove manual, que ya no hace falta) y da doble-clic
         para maximizar y arrastre-a-los-bordes para snap, gratis. Los botones de la barra de
         título se marcan IsHitTestVisibleInChrome para que sigan siendo clicables. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <app:StringToVisibilityConverter x:Key="StrToVis" />
        <app:ActiveBackgroundConverter x:Key="ActiveBg" />
        <app:ActiveForegroundConverter x:Key="ActiveFg" />
        <app:ActiveSolidBackgroundConverter x:Key="ActiveSolidBg" />
        <!-- Misma clase bajo dos claves: el converter "blanco si activo / sub si no" es único. -->
        <app:ActiveSubForegroundConverter x:Key="ActiveWhiteFg" />
        <app:ActiveInkForegroundConverter x:Key="ActiveInkFg" />
        <app:ActiveSubForegroundConverter x:Key="ActiveSubFg" />
        <app:IconKeyToGeometryConverter x:Key="IconKeyToGeometry" />
        <app:EstadoVentanaAMargenConverter x:Key="EstadoAMargen" />
        <app:EstadoVentanaARadioConverter x:Key="EstadoARadio" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <app:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <app:EditandoATextoConverter x:Key="EditandoATexto" />
        <app:BoolToOpacityConverter x:Key="BoolToOpacity" />

        <Style x:Key="NavItemButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,8"
                                BorderThickness="2" BorderBrush="Transparent" Name="b">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Reemplaza al rectangulo punteado por defecto de WPF (quitado
                                 globalmente en App.xaml por no respetar esquinas redondeadas). -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="b" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonoLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>

        <!-- Pills clicables tipo "chip" (intervalo rapido del dashboard). -->
        <Style x:Key="PillToggleButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="999" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Controles de ventana estilo Windows (minimizar/maximizar/cerrar) -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SubBrush}" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <Path Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
                                  Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseTitleBarButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Panel raíz redondeado con sombra (ventana flotante estilo mockup).
         La sombra vive en un Border vacío DETRÁS del contenido: si el efecto envolviera
         al contenido, WPF rasterizaría la ventana completa en superficies intermedias y
         recalcularía la sombra en cada tick del temporizador (mucha RAM y CPU de render).
         Con un Border hermano vacío solo se sombrea el rectángulo redondeado.

         Margen y radio de esquina se apagan al maximizar (Converter sobre WindowState):
         maximizada, la ventana debe llenar el área de trabajo exacta, sin el hueco de 12px
         ni esquinas redondas asomando fuera de la pantalla — igual que Sublime Text. -->
    <Grid Margin="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState, Converter={StaticResource EstadoAMargen}}">
        <Border Background="{DynamicResource PanelBrush}"
                CornerRadius="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState, Converter={StaticResource EstadoARadio}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.18" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState, Converter={StaticResource EstadoARadio}}">
        <Border ClipToBounds="True"
                CornerRadius="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState, Converter={StaticResource EstadoARadio}}">
            <Grid>
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="32" Background="{DynamicResource PanelBrush}">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" DockPanel.Dock="Left">
                            <TextBlock Text="EyeYul" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="v1.2.0" VerticalAlignment="Center" FontFamily="{DynamicResource MonoFont}" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" Background="{DynamicResource AccentSoftBrush}" Padding="6,2" Margin="10,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Style="{StaticResource TitleBarButton}" Click="OnMinimizeClick" ToolTip="Minimizar"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Content>
                                <LineGeometry StartPoint="0,5" EndPoint="10,5" />
                            </Button.Content>
                        </Button>
                        <Button x:Name="BotonMaximizar" Click="OnMaximizeClick" ToolTip="Maximizar"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Content>
                                <RectangleGeometry Rect="0,0,10,10" />
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <GeometryGroup>
                                                        <RectangleGeometry Rect="0,2,8,8" />
                                                        <RectangleGeometry Rect="2,0,8,8" />
                                                    </GeometryGroup>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="ToolTip" Value="Restaurar" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource CloseTitleBarButton}" Click="OnCloseClick" ToolTip="Cerrar"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Content>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,0" EndPoint="10,10" />
                                    <LineGeometry StartPoint="10,0" EndPoint="0,10" />
                                </GeometryGroup>
                            </Button.Content>
                        </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===================== SIDEBAR ===================== -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="18">
                        <!-- Apariencia (abajo) -->
                        <StackPanel DockPanel.Dock="Bottom">
                            <!-- Unica entrada a la ventana de Ajustes desde la app;
                                 antes solo se llegaba por el menu de la bandeja. -->
                            <Button Style="{StaticResource NavItemButton}" Command="{Binding ToggleSettingsModalCommand}"
                                    Background="Transparent" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSettings}" Width="15" Height="15" Stroke="{DynamicResource SubBrush}" />
                                    <TextBlock Text="Ajustes avanzados" Margin="10,0,0,0" FontSize="12.5" Foreground="{DynamicResource SubBrush}" />
                                </StackPanel>
                            </Button>

                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,4,0,0" Opacity="0.7" />

                            <TextBlock Text="APARIENCIA" Style="{StaticResource MonoLabel}" Margin="8,10,0,6" />
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="3">
                                <UniformGrid Rows="1" Columns="3">
                                    <Button Content="Claro" Style="{StaticResource GhostButton}" FontSize="10" Padding="0,6" BorderThickness="0"
                                            Command="{Binding SelectThemeCommand}" CommandParameter="light"
                                            Background="{Binding ThemeMode, Converter={StaticResource ActiveSolidBg}, ConverterParameter=light}"
                                            Foreground="{Binding ThemeMode, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=light}" />
                                    <Button Content="Oscuro" Style="{StaticResource GhostButton}" FontSize="10" Padding="0,6" Margin="3,0" BorderThickness="0"
                                            Command="{Binding SelectThemeCommand}" CommandParameter="dark"
                                            Background="{Binding ThemeMode, Converter={StaticResource ActiveSolidBg}, ConverterParameter=dark}"
                                            Foreground="{Binding ThemeMode, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=dark}" />
                                    <Button Content="Sistema" Style="{StaticResource GhostButton}" FontSize="10" Padding="0,6" BorderThickness="0"
                                            Command="{Binding SelectThemeCommand}" CommandParameter="system"
                                            Background="{Binding ThemeMode, Converter={StaticResource ActiveSolidBg}, ConverterParameter=system}"
                                            Foreground="{Binding ThemeMode, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=system}" />
                                </UniformGrid>
                            </Border>
                            <Button Margin="8,8,0,0" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding AbrirLicenciaCommand}" HorizontalContentAlignment="Stretch"
                                    ToolTip="Ver o activar tu licencia">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Button.Template>
                                <DockPanel>
                                    <TextBlock Text="Licencia" Style="{StaticResource MonoLabel}" FontWeight="Normal" />
                                    <TextBlock Text="{Binding LicenciaEtiqueta}" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MonoLabel}">
                                                <Setter Property="Foreground" Value="{DynamicResource AmberBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LicenciaEsPremium}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </Button>
                        </StackPanel>

                        <!-- Encabezado + búsqueda + nav -->
                        <StackPanel>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,0">
                                <DockPanel>
                                    <Path Style="{DynamicResource Ico}" Data="{StaticResource IcoSearch}" Width="13" Height="13" Stroke="{DynamicResource MutedBrush}" Opacity="0.6" DockPanel.Dock="Left" Margin="2,0,6,0" />
                                    <TextBox BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Height="30" FontSize="11" Foreground="{DynamicResource InkBrush}" />
                                </DockPanel>
                            </Border>

                            <!-- Grupo: Monitor e Historial -->
                            <TextBlock Text="MONITOR E HISTORIAL" Style="{StaticResource MonoLabel}" Margin="8,16,0,6" />
                            <Button Style="{StaticResource NavItemButton}" Command="{Binding SelectTabCommand}" CommandParameter="dashboard"
                                    Background="{Binding ActiveTab, Converter={StaticResource ActiveBg}, ConverterParameter=dashboard}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource PillBadge}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource GreenBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="En Vivo" Style="{StaticResource PillBadgeText}" Foreground="{DynamicResource GreenBrush}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoActivity}" Width="15" Height="15" Stroke="{Binding ActiveTab, Converter={StaticResource ActiveFg}, ConverterParameter=dashboard}" />
                                        <TextBlock Text="Vista General" Margin="10,0,0,0" FontSize="12.5" Foreground="{Binding ActiveTab, Converter={StaticResource ActiveFg}, ConverterParameter=dashboard}" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavItemButton}" Command="{Binding SelectTabCommand}" CommandParameter="stats" Margin="0,4,0,0"
                                    Background="{Binding ActiveTab, Converter={StaticResource ActiveBg}, ConverterParameter=stats}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource PillBadge}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AmberBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ScreenScore, StringFormat={}{0} pts}" Style="{StaticResource PillBadgeText}" Foreground="{DynamicResource AmberBrush}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoAward}" Width="15" Height="15" Stroke="{Binding ActiveTab, Converter={StaticResource ActiveFg}, ConverterParameter=stats}" />
                                        <TextBlock Text="Historial de Uso" Margin="10,0,0,0" FontSize="12.5" Foreground="{Binding ActiveTab, Converter={StaticResource ActiveFg}, ConverterParameter=stats}" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <!-- Grupo: Ajustes de Alerta -->
                            <TextBlock Text="AJUSTES DE ALERTA" Style="{StaticResource MonoLabel}" Margin="8,16,0,6" />
                            <Button Style="{StaticResource NavItemButton}" Command="{Binding SelectTabCommand}" CommandParameter="wellness"
                                    Background="{Binding ActiveTab, Converter={StaticResource ActiveBg}, ConverterParameter=wellness}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoHeart}" Width="15" Height="15" Stroke="{Binding ActiveTab, Converter={StaticResource ActiveFg}, ConverterParameter=wellness}" />
                                    <TextBlock Text="Acciones Saludables" Margin="10,0,0,0" FontSize="12.5" Foreground="{Binding ActiveTab, Converter={StaticResource ActiveFg}, ConverterParameter=wellness}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavItemButton}" Command="{Binding SelectTabCommand}" CommandParameter="automations" Margin="0,4,0,0"
                                    Background="{Binding ActiveTab, Converter={StaticResource ActiveBg}, ConverterParameter=automations}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSparkles}" Width="15" Height="15" Stroke="{Binding ActiveTab, Converter={StaticResource ActiveFg}, ConverterParameter=automations}" />
                                    <TextBlock Text="Smart Pause" Margin="10,0,0,0" FontSize="12.5" Foreground="{Binding ActiveTab, Converter={StaticResource ActiveFg}, ConverterParameter=automations}" />
                                </StackPanel>
                            </Button>

                            <!-- Grupo: Rutina de Descansos -->
                            <TextBlock Text="RUTINA DE DESCANSOS" Style="{StaticResource MonoLabel}" Margin="8,16,0,6" />
                            <Button Style="{StaticResource NavItemButton}" Command="{Binding SelectSubTabCommand}" CommandParameter="timer"
                                    Background="{Binding RoutineSelection, Converter={StaticResource ActiveBg}, ConverterParameter=timer}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoClock}" Width="15" Height="15" Stroke="{Binding RoutineSelection, Converter={StaticResource ActiveFg}, ConverterParameter=timer}" />
                                    <TextBlock Text="Frecuencia" Margin="10,0,0,0" FontSize="12.5" Foreground="{Binding RoutineSelection, Converter={StaticResource ActiveFg}, ConverterParameter=timer}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavItemButton}" Command="{Binding SelectSubTabCommand}" CommandParameter="planned" Margin="0,4,0,0"
                                    Background="{Binding RoutineSelection, Converter={StaticResource ActiveBg}, ConverterParameter=planned}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoCalendar}" Width="15" Height="15" Stroke="{Binding RoutineSelection, Converter={StaticResource ActiveFg}, ConverterParameter=planned}" />
                                    <TextBlock Text="Agenda" Margin="10,0,0,0" FontSize="12.5" Foreground="{Binding RoutineSelection, Converter={StaticResource ActiveFg}, ConverterParameter=planned}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavItemButton}" Command="{Binding SelectSubTabCommand}" CommandParameter="limits" Margin="0,4,0,0"
                                    Background="{Binding RoutineSelection, Converter={StaticResource ActiveBg}, ConverterParameter=limits}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoShield}" Width="15" Height="15" Stroke="{Binding RoutineSelection, Converter={StaticResource ActiveFg}, ConverterParameter=limits}" />
                                    <TextBlock Text="Límites" Margin="10,0,0,0" FontSize="12.5" Foreground="{Binding RoutineSelection, Converter={StaticResource ActiveFg}, ConverterParameter=limits}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavItemButton}" Command="{Binding SelectSubTabCommand}" CommandParameter="messages" Margin="0,4,0,0"
                                    Background="{Binding RoutineSelection, Converter={StaticResource ActiveBg}, ConverterParameter=messages}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoMessage}" Width="15" Height="15" Stroke="{Binding RoutineSelection, Converter={StaticResource ActiveFg}, ConverterParameter=messages}" />
                                    <TextBlock Text="Frases" Margin="10,0,0,0" FontSize="12.5" Foreground="{Binding RoutineSelection, Converter={StaticResource ActiveFg}, ConverterParameter=messages}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ===================== CONTENIDO ===================== -->
                <DockPanel Grid.Column="1">
                    <!-- Header -->
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="24,10">
                        <DockPanel MouseLeftButtonDown="OnDragMove" Background="Transparent">
                            <StackPanel>
                                <TextBlock Text="{Binding HeaderTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource MonoLabel}" FontWeight="Normal" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                        <Grid>
                            <!-- ===== DASHBOARD ===== -->
                            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StrToVis}, ConverterParameter=dashboard}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="7*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="5*" />
                                </Grid.ColumnDefinitions>

                                <comp:TarjetaBase Grid.Column="0">
                                    <DockPanel>
                                        <comp:EtiquetaTitulo Texto="Monitor Inteligente" DockPanel.Dock="Top" />

                                        <!-- Pills de intervalo rapido: mismo camino que el selector de abajo
                                             (IntervaloMinutosText), solo un atajo para los valores mas usados. -->
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                            <TextBlock Text="Intervalo:" VerticalAlignment="Center" FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource SubBrush}" Margin="0,0,8,0" />
                                            <Button Content="15m" Style="{StaticResource PillToggleButton}" Command="{Binding SetIntervalMinutesCommand}" CommandParameter="15"
                                                    Background="{Binding IntervaloMinutosText, Converter={StaticResource ActiveSolidBg}, ConverterParameter=15}"
                                                    Foreground="{Binding IntervaloMinutosText, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=15}" Margin="0,0,4,0" />
                                            <Button Content="20m" Style="{StaticResource PillToggleButton}" Command="{Binding SetIntervalMinutesCommand}" CommandParameter="20"
                                                    Background="{Binding IntervaloMinutosText, Converter={StaticResource ActiveSolidBg}, ConverterParameter=20}"
                                                    Foreground="{Binding IntervaloMinutosText, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=20}" Margin="0,0,4,0" />
                                            <Button Content="30m" Style="{StaticResource PillToggleButton}" Command="{Binding SetIntervalMinutesCommand}" CommandParameter="30"
                                                    Background="{Binding IntervaloMinutosText, Converter={StaticResource ActiveSolidBg}, ConverterParameter=30}"
                                                    Foreground="{Binding IntervaloMinutosText, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=30}" Margin="0,0,4,0" />
                                            <Button Content="45m" Style="{StaticResource PillToggleButton}" Command="{Binding SetIntervalMinutesCommand}" CommandParameter="45"
                                                    Background="{Binding IntervaloMinutosText, Converter={StaticResource ActiveSolidBg}, ConverterParameter=45}"
                                                    Foreground="{Binding IntervaloMinutosText, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=45}" Margin="0,0,4,0" />
                                            <Button Content="60m" Style="{StaticResource PillToggleButton}" Command="{Binding SetIntervalMinutesCommand}" CommandParameter="60"
                                                    Background="{Binding IntervaloMinutosText, Converter={StaticResource ActiveSolidBg}, ConverterParameter=60}"
                                                    Foreground="{Binding IntervaloMinutosText, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=60}" />
                                        </StackPanel>

                                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                            <comp:BotonRelleno Comando="{Binding TogglePauseCommand}" Texto="{Binding PauseButtonText}" />
                                            <comp:BotonRelleno Comando="{Binding ResetCommand}" Texto="Reiniciar" />
                                            <Button Content="Descansar Ya" Style="{StaticResource PrimaryGradientButton}" Command="{Binding StartBreakCommand}" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                            <TextBlock Text="Pausar cada" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SubBrush}" Margin="0,0,8,0" />
                                            <c:SelectorLista ItemsSource="{Binding IntervalosDisponibles}" Seleccionado="{Binding IntervaloMinutosText, Mode=TwoWay}" Width="80" Height="32" />
                                            <TextBlock Text="minutos" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SubBrush}" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <c:AnilloProgreso Percent="{Binding Percent}" CenterText="{Binding TimerText}" RingBrush="{StaticResource AccentGradientBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,18" />
                                    </DockPanel>
                                </comp:TarjetaBase>

                                <StackPanel Grid.Column="2">
                                    <!-- Indice de fatiga ocular: derivado del Screen Score real de hoy, no un
                                         numero simulado. -->
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
                                                        <Path Style="{DynamicResource Ico}" Data="{StaticResource IcoEye}" Width="15" Height="15" Stroke="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Margin="10,0,0,0">
                                                        <TextBlock Text="Índice de Fatiga Ocular" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
                                                        <TextBlock Text="Estimado con el Screen Score de hoy" FontSize="9" Foreground="{DynamicResource SubBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource PillBadge}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EyeStrainIndexPercent, StringFormat={}{0}%}" Style="{StaticResource PillBadgeText}" Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                            </DockPanel>
                                            <ProgressBar Value="{Binding EyeStrainIndexPercent, Mode=OneWay}" Margin="0,12,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Consejo del momento: reusa las Frases de Bienestar reales en vez de
                                         simular un sensor de parpadeo (no hay forma de medirlo sin camara). -->
                                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
                                                    <Path Style="{DynamicResource Ico}" Data="{StaticResource IcoSparkles}" Width="15" Height="15" Stroke="{DynamicResource AmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Consejo del Momento" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
                                                    <TextBlock Text="De tus Frases de Bienestar" FontSize="9" Foreground="{DynamicResource SubBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="{Binding TipDelMomento}" FontSize="11" Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Filtro de luz azul: acceso rapido real (toggle + temperatura). Cubre
                                         toda la pantalla con un tinte via ControladorFiltroLuzWpf. -->
                                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
                                                        <Path Style="{DynamicResource Ico}" Data="{StaticResource IcoSun}" Width="15" Height="15" Stroke="{DynamicResource AmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Margin="10,0,0,0">
                                                        <TextBlock Text="Filtro de Luz Azul" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
                                                        <TextBlock Foreground="{DynamicResource SubBrush}" FontSize="9">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Desactivado" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding BlueLightEnabled}" Value="True">
                                                                            <Setter Property="Text" Value="{Binding BlueLightKelvin, StringFormat={}{0}K · tono cálido}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                                <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="{Binding BlueLightEnabled}" />
                                            </DockPanel>
                                            <StackPanel Margin="0,12,0,0" Visibility="{Binding BlueLightEnabled, Converter={StaticResource BoolToVis}}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="Temperatura cálida" FontSize="9" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource SubBrush}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding BlueLightKelvin, StringFormat={}{0} K}" FontSize="9" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                </DockPanel>
                                                <Slider Minimum="1800" Maximum="6500" Value="{Binding BlueLightKelvin}" IsSnapToTickEnabled="True" TickFrequency="100" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- ===== STATS / Historial de Uso ===== -->
                            <StackPanel Visibility="{Binding ActiveTab, Converter={StaticResource StrToVis}, ConverterParameter=stats}">
                                <DockPanel Margin="0,0,0,16">
                                    <TextBlock DockPanel.Dock="Left" Text="Viendo el día:" FontSize="11" Foreground="{DynamicResource SubBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <c:SelectorFecha Fecha="{Binding HistorialFecha, Mode=TwoWay}" Height="34" HorizontalAlignment="Left" Width="150" />
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Path Style="{DynamicResource Ico}" Data="{StaticResource IcoHourglass}" Width="18" Height="18" Stroke="{StaticResource AccentBrush}" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding HistorialTiempoActivo}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,0" />
                                            <TextBlock Text="TIEMPO ACTIVO" Style="{StaticResource MonoLabel}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Path Style="{DynamicResource Ico}" Data="{StaticResource IcoShieldCheck}" Width="18" Height="18" Stroke="{StaticResource AmberBrush}" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding HistorialPuntaje, StringFormat={}{0} pts}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,0" />
                                            <TextBlock Text="SCREEN SCORE" Style="{StaticResource MonoLabel}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoFlame}" Width="18" Height="18" Stroke="#F97316" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding HistorialRachaDias}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,0" />
                                            <TextBlock Text="RACHA DE CONSISTENCIA" Style="{StaticResource MonoLabel}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource Card}" CornerRadius="14" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Screen Score por Día" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource InkBrush}" />
                                        <TextBlock Text="Últimos 7 días hasta la fecha elegida" FontSize="10" Foreground="{DynamicResource SubBrush}" Margin="0,2,0,12" />
                                        <ItemsControl ItemsSource="{Binding WeeklyBars}" Height="150">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Bottom" Margin="4,0">
                                                        <TextBlock Text="{Binding Value}" FontFamily="{DynamicResource MonoFont}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                        <Border Height="{Binding Height}" CornerRadius="6,6,0,0" Background="{DynamicResource AccentBrush}" />
                                                        <TextBlock Text="{Binding Label}" FontFamily="{DynamicResource MonoFont}" FontSize="9" Foreground="{DynamicResource SubBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== WELLNESS: Acciones Saludables ===== -->
                            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StrToVis}, ConverterParameter=wellness}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Postura -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" CornerRadius="14">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="SALUD CORPORAL" Style="{DynamicResource MonoLabel}" Foreground="{DynamicResource SubBrush}" />
                                            <Path DockPanel.Dock="Right" Style="{DynamicResource Ico}" Data="{StaticResource IcoChevronsUp}" Stroke="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <TextBlock Text="Alerta de Postura" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,10,0,0" />
                                        <TextBlock Text="Recordatorio para enderezar la espalda cada cierto tiempo." FontSize="10" Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                                        <UniformGrid Rows="1" Columns="4">
                                            <Button Content="Off" Command="{Binding SetAccionMinutosCommand}" CommandParameter="postura:0" Style="{StaticResource NavItemButton}" Margin="0,0,3,0" HorizontalContentAlignment="Center" FontSize="10"
                                                    Background="{Binding PosturaMinutos, Converter={StaticResource ActiveSolidBg}, ConverterParameter=0}" Foreground="{Binding PosturaMinutos, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=0}" />
                                            <Button Content="10m" Command="{Binding SetAccionMinutosCommand}" CommandParameter="postura:10" Style="{StaticResource NavItemButton}" Margin="3,0" HorizontalContentAlignment="Center" FontSize="10"
                                                    Background="{Binding PosturaMinutos, Converter={StaticResource ActiveSolidBg}, ConverterParameter=10}" Foreground="{Binding PosturaMinutos, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=10}" />
                                            <Button Content="20m" Command="{Binding SetAccionMinutosCommand}" CommandParameter="postura:20" Style="{StaticResource NavItemButton}" Margin="3,0" HorizontalContentAlignment="Center" FontSize="10"
                                                    Background="{Binding PosturaMinutos, Converter={StaticResource ActiveSolidBg}, ConverterParameter=20}" Foreground="{Binding PosturaMinutos, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=20}" />
                                            <Button Content="30m" Command="{Binding SetAccionMinutosCommand}" CommandParameter="postura:30" Style="{StaticResource NavItemButton}" Margin="3,0,0,0" HorizontalContentAlignment="Center" FontSize="10"
                                                    Background="{Binding PosturaMinutos, Converter={StaticResource ActiveSolidBg}, ConverterParameter=30}" Foreground="{Binding PosturaMinutos, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=30}" />
                                        </UniformGrid>
                                        <Button Command="{Binding ProbarAccionCommand}" CommandParameter="postura" Style="{StaticResource GhostButton}" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Style="{DynamicResource Ico}" Data="{StaticResource IcoBell}" Width="13" Height="13" Stroke="{StaticResource AccentBrush}" />
                                                <TextBlock Text="Probar Alerta" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Parpadeo -->
                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" CornerRadius="14">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="HUMECTACIÓN OCULAR" Style="{DynamicResource MonoLabel}" Foreground="{DynamicResource SubBrush}" />
                                            <Path DockPanel.Dock="Right" Style="{DynamicResource Ico}" Data="{StaticResource IcoEye}" Stroke="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <TextBlock Text="Recordatorio de Parpadeo" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,10,0,0" />
                                        <TextBlock Text="Señal para motivar parpadeos rítmicos contra el ojo seco." FontSize="10" Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                                        <UniformGrid Rows="1" Columns="4">
                                            <Button Content="Off" Command="{Binding SetAccionMinutosCommand}" CommandParameter="parpadeo:0" Style="{StaticResource NavItemButton}" Margin="0,0,3,0" HorizontalContentAlignment="Center" FontSize="10"
                                                    Background="{Binding ParpadeoMinutos, Converter={StaticResource ActiveSolidBg}, ConverterParameter=0}" Foreground="{Binding ParpadeoMinutos, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=0}" />
                                            <Button Content="5m" Command="{Binding SetAccionMinutosCommand}" CommandParameter="parpadeo:5" Style="{StaticResource NavItemButton}" Margin="3,0" HorizontalContentAlignment="Center" FontSize="10"
                                                    Background="{Binding ParpadeoMinutos, Converter={StaticResource ActiveSolidBg}, ConverterParameter=5}" Foreground="{Binding ParpadeoMinutos, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=5}" />
                                            <Button Content="10m" Command="{Binding SetAccionMinutosCommand}" CommandParameter="parpadeo:10" Style="{StaticResource NavItemButton}" Margin="3,0" HorizontalContentAlignment="Center" FontSize="10"
                                                    Background="{Binding ParpadeoMinutos, Converter={StaticResource ActiveSolidBg}, ConverterParameter=10}" Foreground="{Binding ParpadeoMinutos, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=10}" />
                                            <Button Content="15m" Command="{Binding SetAccionMinutosCommand}" CommandParameter="parpadeo:15" Style="{StaticResource NavItemButton}" Margin="3,0,0,0" HorizontalContentAlignment="Center" FontSize="10"
                                                    Background="{Binding ParpadeoMinutos, Converter={StaticResource ActiveSolidBg}, ConverterParameter=15}" Foreground="{Binding ParpadeoMinutos, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=15}" />
                                        </UniformGrid>
                                        <Button Command="{Binding ProbarAccionCommand}" CommandParameter="parpadeo" Style="{StaticResource GhostButton}" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Style="{DynamicResource Ico}" Data="{StaticResource IcoBell}" Width="13" Height="13" Stroke="{StaticResource AccentBrush}" />
                                                <TextBlock Text="Probar Alerta" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Hidratacion -->
                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" CornerRadius="14">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="HIDRATACIÓN" Style="{DynamicResource MonoLabel}" Foreground="{DynamicResource SubBrush}" />
                                            <Path DockPanel.Dock="Right" Style="{DynamicResource Ico}" Data="{StaticResource IcoDroplet}" Stroke="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <TextBlock Text="Recordatorio para Hidratarte" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,10,0,0" />
                                        <TextBlock Text="Un aviso corto para que tomes agua durante el día." FontSize="10" Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                                        <UniformGrid Rows="1" Columns="4">
                                            <Button Content="Off" Command="{Binding SetAccionMinutosCommand}" CommandParameter="hidratacion:0" Style="{StaticResource NavItemButton}" Margin="0,0,3,0" HorizontalContentAlignment="Center" FontSize="10"
                                                    Background="{Binding HidratacionMinutos, Converter={StaticResource ActiveSolidBg}, ConverterParameter=0}" Foreground="{Binding HidratacionMinutos, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=0}" />
                                            <Button Content="20m" Command="{Binding SetAccionMinutosCommand}" CommandParameter="hidratacion:20" Style="{StaticResource NavItemButton}" Margin="3,0" HorizontalContentAlignment="Center" FontSize="10"
                                                    Background="{Binding HidratacionMinutos, Converter={StaticResource ActiveSolidBg}, ConverterParameter=20}" Foreground="{Binding HidratacionMinutos, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=20}" />
                                            <Button Content="30m" Command="{Binding SetAccionMinutosCommand}" CommandParameter="hidratacion:30" Style="{StaticResource NavItemButton}" Margin="3,0" HorizontalContentAlignment="Center" FontSize="10"
                                                    Background="{Binding HidratacionMinutos, Converter={StaticResource ActiveSolidBg}, ConverterParameter=30}" Foreground="{Binding HidratacionMinutos, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=30}" />
                                            <Button Content="45m" Command="{Binding SetAccionMinutosCommand}" CommandParameter="hidratacion:45" Style="{StaticResource NavItemButton}" Margin="3,0,0,0" HorizontalContentAlignment="Center" FontSize="10"
                                                    Background="{Binding HidratacionMinutos, Converter={StaticResource ActiveSolidBg}, ConverterParameter=45}" Foreground="{Binding HidratacionMinutos, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=45}" />
                                        </UniformGrid>
                                        <Button Command="{Binding ProbarAccionCommand}" CommandParameter="hidratacion" Style="{StaticResource GhostButton}" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Style="{DynamicResource Ico}" Data="{StaticResource IcoBell}" Width="13" Height="13" Stroke="{StaticResource AccentBrush}" />
                                                <TextBlock Text="Probar Alerta" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Estiramiento -->
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" CornerRadius="14">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="MOVIMIENTO" Style="{DynamicResource MonoLabel}" Foreground="{DynamicResource SubBrush}" />
                                            <Path DockPanel.Dock="Right" Style="{DynamicResource Ico}" Data="{StaticResource IcoEstirar}" Stroke="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <TextBlock Text="Recordatorio de Estiramiento" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,10,0,0" />
                                        <TextBlock Text="Una pausa cortita para estirar brazos, cuello y espalda." FontSize="10" Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                                        <UniformGrid Rows="1" Columns="4">
                                            <Button Content="Off" Command="{Binding SetAccionMinutosCommand}" CommandParameter="estiramiento:0" Style="{StaticResource NavItemButton}" Margin="0,0,3,0" HorizontalContentAlignment="Center" FontSize="10"
                                                    Background="{Binding EstiramientoMinutos, Converter={StaticResource ActiveSolidBg}, ConverterParameter=0}" Foreground="{Binding EstiramientoMinutos, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=0}" />
                                            <Button Content="20m" Command="{Binding SetAccionMinutosCommand}" CommandParameter="estiramiento:20" Style="{StaticResource NavItemButton}" Margin="3,0" HorizontalContentAlignment="Center" FontSize="10"
                                                    Background="{Binding EstiramientoMinutos, Converter={StaticResource ActiveSolidBg}, ConverterParameter=20}" Foreground="{Binding EstiramientoMinutos, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=20}" />
                                            <Button Content="30m" Command="{Binding SetAccionMinutosCommand}" CommandParameter="estiramiento:30" Style="{StaticResource NavItemButton}" Margin="3,0" HorizontalContentAlignment="Center" FontSize="10"
                                                    Background="{Binding EstiramientoMinutos, Converter={StaticResource ActiveSolidBg}, ConverterParameter=30}" Foreground="{Binding EstiramientoMinutos, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=30}" />
                                            <Button Content="45m" Command="{Binding SetAccionMinutosCommand}" CommandParameter="estiramiento:45" Style="{StaticResource NavItemButton}" Margin="3,0,0,0" HorizontalContentAlignment="Center" FontSize="10"
                                                    Background="{Binding EstiramientoMinutos, Converter={StaticResource ActiveSolidBg}, ConverterParameter=45}" Foreground="{Binding EstiramientoMinutos, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=45}" />
                                        </UniformGrid>
                                        <Button Command="{Binding ProbarAccionCommand}" CommandParameter="estiramiento" Style="{StaticResource GhostButton}" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Style="{DynamicResource Ico}" Data="{StaticResource IcoBell}" Width="13" Height="13" Stroke="{StaticResource AccentBrush}" />
                                                <TextBlock Text="Probar Alerta" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ===== AUTOMATIONS (Smart Pause) ===== -->
                            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StrToVis}, ConverterParameter=automations}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- No incluye "Modo No Molestar": Windows no da una API publica para que una
                                     app de terceros ACTIVE Focus Assist, solo para leerlo (eso ya se respeta
                                     arriba en RespectFocusAssist). Prometer un toggle que no hace nada es peor
                                     que no tenerlo. -->
                                <Border Grid.Column="0" Style="{StaticResource Card}" CornerRadius="14">
                                    <StackPanel>
                                        <TextBlock Text="FILTROS DE CONTEXTO" Style="{StaticResource MonoLabel}" Margin="0,0,0,12" />
                                        <DockPanel Margin="0,0,0,12">
                                            <Path Style="{DynamicResource Ico}" Data="{StaticResource IcoVideo}" Width="15" Height="15" Stroke="{StaticResource AccentBrush}" VerticalAlignment="Top" />
                                            <CheckBox DockPanel.Dock="Right" VerticalAlignment="Top" IsChecked="{Binding SmartPauseRespectMeetings}" />
                                            <StackPanel Margin="10,0,10,0"><TextBlock Text="Reuniones / Videollamadas" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" /><TextBlock Text="Pospone descansos durante Zoom, Meet, Teams." FontSize="9" Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" /></StackPanel>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <Path Style="{DynamicResource Ico}" Data="{StaticResource IcoTv}" Width="15" Height="15" Stroke="{StaticResource AccentBrush}" VerticalAlignment="Top" />
                                            <CheckBox DockPanel.Dock="Right" VerticalAlignment="Top" IsChecked="{Binding SmartPauseRespectFullscreen}" />
                                            <StackPanel Margin="10,0,10,0"><TextBlock Text="Pantalla Completa" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" /><TextBlock Text="Video o juegos: no interrumpe si algo ocupa toda la pantalla." FontSize="9" Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" /></StackPanel>
                                        </DockPanel>
                                        <DockPanel>
                                            <Path Style="{DynamicResource Ico}" Data="{StaticResource IcoShare}" Width="15" Height="15" Stroke="{StaticResource AccentBrush}" VerticalAlignment="Top" />
                                            <CheckBox DockPanel.Dock="Right" VerticalAlignment="Top" IsChecked="{Binding SmartPauseDetectScreenSharing}" />
                                            <StackPanel Margin="10,0,10,0"><TextBlock Text="Grabación o Compartición" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" /><TextBlock Text="Evita alertas si estás grabando o compartiendo pantalla." FontSize="9" Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" /></StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" CornerRadius="14">
                                    <StackPanel>
                                        <TextBlock Text="ACCIONES DE AUTOMATIZACIÓN" Style="{StaticResource MonoLabel}" Margin="0,0,0,12" />
                                        <DockPanel Margin="0,0,0,12">
                                            <Path Style="{DynamicResource Ico}" Data="{StaticResource IcoVolumeX}" Width="15" Height="15" Stroke="{StaticResource AccentBrush}" VerticalAlignment="Top" />
                                            <CheckBox DockPanel.Dock="Right" VerticalAlignment="Top" IsChecked="{Binding SmartPausePauseMusic}" />
                                            <StackPanel Margin="10,0,10,0"><TextBlock Text="Pausar Reproducción de Música" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" /><TextBlock Text="Envía Play/Pausa al iniciar el descanso." FontSize="9" Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" /></StackPanel>
                                        </DockPanel>
                                        <DockPanel>
                                            <Path Style="{DynamicResource Ico}" Data="{StaticResource IcoActivity}" Width="15" Height="15" Stroke="{StaticResource AccentBrush}" VerticalAlignment="Top" />
                                            <CheckBox DockPanel.Dock="Right" VerticalAlignment="Top" IsChecked="{Binding SmartPausePauseOnTyping}" />
                                            <StackPanel Margin="10,0,10,0"><TextBlock Text="Pausar por Escritura Activa" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" /><TextBlock Text="Pospone la pausa mientras detecta tipeo activo." FontSize="9" Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" /></StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ===== ROUTINE ===== -->
                            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource StrToVis}, ConverterParameter=routine}">
                            <!-- ROUTINE: Frecuencia -->
                            <StackPanel Visibility="{Binding ActiveSubTab, Converter={StaticResource StrToVis}, ConverterParameter=timer}">
                                <TextBlock Text="Modos de Trabajo Predefinidos" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="Cambia rápidamente los intervalos con fórmulas optimizadas de salud:" FontSize="11" Foreground="{DynamicResource SubBrush}" Margin="0,4,0,12" />
                                <UniformGrid Columns="2" Rows="2">
                                    <!-- Modo: Equilibrado -->
                                    <Button Command="{Binding SetModeCommand}" CommandParameter="balanced" Style="{StaticResource NavItemButton}" Margin="0,0,6,6" Background="{Binding ActiveRoutineMode, Converter={StaticResource ActiveSolidBg}, ConverterParameter=balanced}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="12" Background="#33888888" VerticalAlignment="Top">
                                                <Path Style="{StaticResource Ico}" Data="{StaticResource IcoFlame}" Stroke="{Binding ActiveRoutineMode, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=balanced}" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0">
                                                <TextBlock Text="Equilibrado" FontWeight="Bold" FontSize="12" Foreground="{Binding ActiveRoutineMode, Converter={StaticResource ActiveInkFg}, ConverterParameter=balanced}" />
                                                <TextBlock Text="La regla clásica: 20 mins de trabajo, 30 segs de descanso." FontSize="10" Foreground="{Binding ActiveRoutineMode, Converter={StaticResource ActiveSubFg}, ConverterParameter=balanced}" Opacity="0.9" TextWrapping="Wrap" Margin="0,3" />
                                                <TextBlock Text="20m trabajo / 30s descanso" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{Binding ActiveRoutineMode, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=balanced}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                    <!-- Modo: Enfoque Profundo -->
                                    <Button Command="{Binding SetModeCommand}" CommandParameter="deep" Style="{StaticResource NavItemButton}" Margin="6,0,0,6" Background="{Binding ActiveRoutineMode, Converter={StaticResource ActiveSolidBg}, ConverterParameter=deep}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="12" Background="#33888888" VerticalAlignment="Top">
                                                <Path Style="{DynamicResource Ico}" Data="{StaticResource IcoBrain}" Stroke="{Binding ActiveRoutineMode, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=deep}" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0">
                                                <TextBlock Text="Enfoque Profundo" FontWeight="Bold" FontSize="12" Foreground="{Binding ActiveRoutineMode, Converter={StaticResource ActiveInkFg}, ConverterParameter=deep}" />
                                                <TextBlock Text="Sesiones largas: 45 mins de trabajo, 1 min de pausa." FontSize="10" Foreground="{Binding ActiveRoutineMode, Converter={StaticResource ActiveSubFg}, ConverterParameter=deep}" TextWrapping="Wrap" Margin="0,3" />
                                                <TextBlock Text="45m trabajo / 60s descanso" FontFamily="{DynamicResource MonoFont}" FontSize="10" Foreground="{Binding ActiveRoutineMode, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=deep}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                    <!-- Modo: Cuidado Ocular -->
                                    <Button Command="{Binding SetModeCommand}" CommandParameter="eye" Style="{StaticResource NavItemButton}" Margin="0,6,6,0" Background="{Binding ActiveRoutineMode, Converter={StaticResource ActiveSolidBg}, ConverterParameter=eye}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="12" Background="#33888888" VerticalAlignment="Top">
                                                <Path Style="{DynamicResource Ico}" Data="{StaticResource IcoEye}" Stroke="{Binding ActiveRoutineMode, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=eye}" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0">
                                                <TextBlock Text="Cuidado Ocular" FontWeight="Bold" FontSize="12" Foreground="{Binding ActiveRoutineMode, Converter={StaticResource ActiveInkFg}, ConverterParameter=eye}" />
                                                <TextBlock Text="Frecuente alivio: 15 mins de trabajo, 20 segs de pausa." FontSize="10" Foreground="{Binding ActiveRoutineMode, Converter={StaticResource ActiveSubFg}, ConverterParameter=eye}" TextWrapping="Wrap" Margin="0,3" />
                                                <TextBlock Text="15m trabajo / 20s descanso" FontFamily="{DynamicResource MonoFont}" FontSize="10" Foreground="{Binding ActiveRoutineMode, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=eye}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                    <!-- Modo: Bienestar Total -->
                                    <Button Command="{Binding SetModeCommand}" CommandParameter="wellness" Style="{StaticResource NavItemButton}" Margin="6,6,0,0" Background="{Binding ActiveRoutineMode, Converter={StaticResource ActiveSolidBg}, ConverterParameter=wellness}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="12" Background="#33888888" VerticalAlignment="Top">
                                                <Path Style="{DynamicResource Ico}" Data="{StaticResource IcoHeart}" Stroke="{Binding ActiveRoutineMode, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=wellness}" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0">
                                                <TextBlock Text="Bienestar Total" FontWeight="Bold" FontSize="12" Foreground="{Binding ActiveRoutineMode, Converter={StaticResource ActiveInkFg}, ConverterParameter=wellness}" />
                                                <TextBlock Text="Salud mental: 30 mins de trabajo, 45 segs de descanso." FontSize="10" Foreground="{Binding ActiveRoutineMode, Converter={StaticResource ActiveSubFg}, ConverterParameter=wellness}" TextWrapping="Wrap" Margin="0,3" />
                                                <TextBlock Text="30m trabajo / 45s descanso" FontFamily="{DynamicResource MonoFont}" FontSize="10" Foreground="{Binding ActiveRoutineMode, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=wellness}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>

                            <!-- ROUTINE: Agenda -->
                            <StackPanel Visibility="{Binding ActiveSubTab, Converter={StaticResource StrToVis}, ConverterParameter=planned}">
                                <TextBlock Text="Pausas Planificadas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="Agenda descansos fijos: almuerzo, estiramientos, café." FontSize="11" Foreground="{DynamicResource SubBrush}" Margin="0,4,0,16" />

                                <Border Style="{StaticResource Card}" CornerRadius="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Nueva pausa" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Nombre" FontSize="9" Foreground="{DynamicResource SubBrush}" Margin="2,0,0,3" />
                                                <TextBox Text="{Binding NewBreakName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Foreground="{DynamicResource InkBrush}" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Hora" FontSize="9" Foreground="{DynamicResource SubBrush}" Margin="2,0,0,3" />
                                                <c:SelectorLista ItemsSource="{Binding HorasDisponibles}" Seleccionado="{Binding NewBreakTime, Mode=TwoWay}" Height="34" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Duración (min)" FontSize="9" Foreground="{DynamicResource SubBrush}" Margin="2,0,0,3" />
                                                <TextBox Text="{Binding NewBreakDurationMinutes, UpdateSourceTrigger=PropertyChanged}" Padding="8" Foreground="{DynamicResource InkBrush}" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Repetir" FontSize="9" Foreground="{DynamicResource SubBrush}" Margin="2,12,0,3" />
                                        <UniformGrid Rows="1" Columns="4">
                                            <Button Content="No se repite" Command="{Binding SetNewBreakRecurrenciaCommand}" CommandParameter="once" Style="{StaticResource NavItemButton}" Margin="0,0,3,0" HorizontalContentAlignment="Center"
                                                    Background="{Binding NewBreakRecurrencia, Converter={StaticResource ActiveSolidBg}, ConverterParameter=once}"
                                                    Foreground="{Binding NewBreakRecurrencia, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=once}" FontSize="10.5" />
                                            <Button Content="Cada día" Command="{Binding SetNewBreakRecurrenciaCommand}" CommandParameter="daily" Style="{StaticResource NavItemButton}" Margin="3,0" HorizontalContentAlignment="Center"
                                                    Background="{Binding NewBreakRecurrencia, Converter={StaticResource ActiveSolidBg}, ConverterParameter=daily}"
                                                    Foreground="{Binding NewBreakRecurrencia, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=daily}" FontSize="10.5" />
                                            <Button Content="Cada semana" Command="{Binding SetNewBreakRecurrenciaCommand}" CommandParameter="weekly" Style="{StaticResource NavItemButton}" Margin="3,0" HorizontalContentAlignment="Center"
                                                    Background="{Binding NewBreakRecurrencia, Converter={StaticResource ActiveSolidBg}, ConverterParameter=weekly}"
                                                    Foreground="{Binding NewBreakRecurrencia, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=weekly}" FontSize="10.5" />
                                            <Button Content="Cada mes" Command="{Binding SetNewBreakRecurrenciaCommand}" CommandParameter="monthly" Style="{StaticResource NavItemButton}" Margin="3,0,0,0" HorizontalContentAlignment="Center"
                                                    Background="{Binding NewBreakRecurrencia, Converter={StaticResource ActiveSolidBg}, ConverterParameter=monthly}"
                                                    Foreground="{Binding NewBreakRecurrencia, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=monthly}" FontSize="10.5" />
                                        </UniformGrid>

                                        <!-- Semanal: dias de la semana -->
                                        <UniformGrid Rows="1" Columns="7" Margin="0,10,0,0" Visibility="{Binding NewBreakRecurrencia, Converter={StaticResource StrToVis}, ConverterParameter=weekly}">
                                            <CheckBox Content="L" IsChecked="{Binding NewBreakMon}" HorizontalAlignment="Center" Foreground="{DynamicResource InkBrush}" />
                                            <CheckBox Content="M" IsChecked="{Binding NewBreakTue}" HorizontalAlignment="Center" Foreground="{DynamicResource InkBrush}" />
                                            <CheckBox Content="X" IsChecked="{Binding NewBreakWed}" HorizontalAlignment="Center" Foreground="{DynamicResource InkBrush}" />
                                            <CheckBox Content="J" IsChecked="{Binding NewBreakThu}" HorizontalAlignment="Center" Foreground="{DynamicResource InkBrush}" />
                                            <CheckBox Content="V" IsChecked="{Binding NewBreakFri}" HorizontalAlignment="Center" Foreground="{DynamicResource InkBrush}" />
                                            <CheckBox Content="S" IsChecked="{Binding NewBreakSat}" HorizontalAlignment="Center" Foreground="{DynamicResource InkBrush}" />
                                            <CheckBox Content="D" IsChecked="{Binding NewBreakSun}" HorizontalAlignment="Center" Foreground="{DynamicResource InkBrush}" />
                                        </UniformGrid>

                                        <!-- Mensual: dia del mes -->
                                        <StackPanel Margin="0,10,0,0" Visibility="{Binding NewBreakRecurrencia, Converter={StaticResource StrToVis}, ConverterParameter=monthly}">
                                            <TextBlock Text="Día del mes" FontSize="9" Foreground="{DynamicResource SubBrush}" Margin="2,0,0,3" />
                                            <c:SelectorLista ItemsSource="{Binding DiasDelMesDisponibles}" Seleccionado="{Binding NewBreakDayOfMonth, Mode=TwoWay}" Height="34" HorizontalAlignment="Left" Width="90" />
                                        </StackPanel>

                                        <!-- Una vez: fecha especifica -->
                                        <StackPanel Margin="0,10,0,0" Visibility="{Binding NewBreakRecurrencia, Converter={StaticResource StrToVis}, ConverterParameter=once}">
                                            <TextBlock Text="Fecha" FontSize="9" Foreground="{DynamicResource SubBrush}" Margin="2,0,0,3" />
                                            <c:SelectorFecha Fecha="{Binding NewBreakDate, Mode=TwoWay}" Height="34" HorizontalAlignment="Left" Width="140" />
                                        </StackPanel>

                                        <Button Content="+ Añadir pausa" Style="{StaticResource PrimaryButton}" Command="{Binding AddPlannedBreakCommand}" HorizontalAlignment="Right" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding PlannedBreaks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" CornerRadius="16" Margin="0,0,0,10">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                                        <Path Style="{StaticResource Ico}" Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" Width="16" Height="16" Stroke="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <Button DockPanel.Dock="Right" Command="{Binding DataContext.RemovePlannedBreakCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Id}"
                                                            Style="{StaticResource GhostButton}" Padding="8" BorderThickness="0" Background="Transparent" VerticalAlignment="Center">
                                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoTrash}" Width="14" Height="14" Stroke="{DynamicResource SubBrush}" />
                                                    </Button>
                                                    <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="999" Padding="8,2" Margin="8,0,0,0" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding TimeText}" FontFamily="{DynamicResource MonoFont}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                            </Border>
                                                        </DockPanel>
                                                        <TextBlock Foreground="{DynamicResource SubBrush}" FontSize="10" Margin="0,3,0,0">
                                                            <Run Text="{Binding DurationText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DaysText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- ROUTINE: Límites -->
                            <StackPanel Visibility="{Binding ActiveSubTab, Converter={StaticResource StrToVis}, ConverterParameter=limits}">
                                <TextBlock Text="Grados de Restricción" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,16" />
                                <UniformGrid Columns="3" Rows="1">
                                    <Button Command="{Binding SetRestrictionModeCommand}" CommandParameter="free" Style="{StaticResource NavItemButton}" Margin="0,0,6,0"
                                            Background="{Binding ActiveRestrictionMode, Converter={StaticResource ActiveSolidBg}, ConverterParameter=free}">
                                        <StackPanel>
                                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoShieldCheck}" Width="18" Height="18" HorizontalAlignment="Left"
                                                  Stroke="{Binding ActiveRestrictionMode, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=free}" />
                                            <TextBlock Text="Modo Libre" FontWeight="Bold" FontSize="12" Margin="0,8,0,0" Foreground="{Binding ActiveRestrictionMode, Converter={StaticResource ActiveInkFg}, ConverterParameter=free}" />
                                            <TextBlock Text="Pospón o salta descansos sin límites. Ideal para gaming." FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{Binding ActiveRestrictionMode, Converter={StaticResource ActiveSubFg}, ConverterParameter=free}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SetRestrictionModeCommand}" CommandParameter="moderate" Style="{StaticResource NavItemButton}" Margin="6,0"
                                            Background="{Binding ActiveRestrictionMode, Converter={StaticResource ActiveSolidBg}, ConverterParameter=moderate}">
                                        <StackPanel>
                                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoShield}" Width="18" Height="18" HorizontalAlignment="Left"
                                                  Stroke="{Binding ActiveRestrictionMode, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=moderate}" />
                                            <TextBlock Text="Modo Moderado" FontWeight="Bold" FontSize="12" Margin="0,8,0,0" Foreground="{Binding ActiveRestrictionMode, Converter={StaticResource ActiveInkFg}, ConverterParameter=moderate}" />
                                            <TextBlock Text="Permite posponer un número limitado de veces por día." FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{Binding ActiveRestrictionMode, Converter={StaticResource ActiveSubFg}, ConverterParameter=moderate}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SetRestrictionModeCommand}" CommandParameter="strict" Style="{StaticResource NavItemButton}" Margin="6,0,0,0"
                                            Background="{Binding ActiveRestrictionMode, Converter={StaticResource ActiveSolidBg}, ConverterParameter=strict}">
                                        <StackPanel>
                                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoShieldAlert}" Width="18" Height="18" HorizontalAlignment="Left"
                                                  Stroke="{Binding ActiveRestrictionMode, Converter={StaticResource ActiveWhiteFg}, ConverterParameter=strict}" />
                                            <TextBlock Text="Modo Estricto" FontWeight="Bold" FontSize="12" Margin="0,8,0,0" Foreground="{Binding ActiveRestrictionMode, Converter={StaticResource ActiveInkFg}, ConverterParameter=strict}" />
                                            <TextBlock Text="Bloquea la pantalla. Debes completar la pausa completa." FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{Binding ActiveRestrictionMode, Converter={StaticResource ActiveSubFg}, ConverterParameter=strict}" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>

                            <!-- ROUTINE: Frases -->
                            <StackPanel Visibility="{Binding ActiveSubTab, Converter={StaticResource StrToVis}, ConverterParameter=messages}">
                                <TextBlock Text="Frases de Bienestar" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="Habilita o deshabilita las de fábrica, o crea las tuyas con su propio icono:" FontSize="11" Foreground="{DynamicResource SubBrush}" Margin="0,4,0,12" />
                                <DockPanel>
                                    <c:SelectorIcono DockPanel.Dock="Left" ItemsSource="{Binding IconosDisponibles}" Seleccionado="{Binding NewMessageIcon, Mode=TwoWay}" Width="38" Height="38" Margin="0,0,8,0" />
                                    <Button DockPanel.Dock="Right" Content="Cancelar" Style="{StaticResource GhostButton}" Command="{Binding CancelEditMessageCommand}" Margin="8,0,0,0" Visibility="{Binding EstaEditandoFrase, Converter={StaticResource BoolToVis}}" />
                                    <Button DockPanel.Dock="Right" Content="{Binding EstaEditandoFrase, Converter={StaticResource EditandoATexto}}" Style="{StaticResource PrimaryButton}" Command="{Binding AddMessageCommand}" Margin="8,0,0,0" />
                                    <TextBox Text="{Binding NewMessageText, UpdateSourceTrigger=PropertyChanged}" Padding="8" Foreground="{DynamicResource InkBrush}" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}" VerticalContentAlignment="Center" />
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding Frases}" Margin="0,16,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" CornerRadius="14" Margin="0,0,0,8">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <Path Style="{StaticResource Ico}" Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" Width="14" Height="14" Stroke="{DynamicResource AccentBrush}" />
                                                    </Border>

                                                    <Button DockPanel.Dock="Right" Command="{Binding DataContext.RemoveMessageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Id}"
                                                            Style="{StaticResource GhostButton}" Padding="8" BorderThickness="0" Background="Transparent"
                                                            Visibility="{Binding EsPredefinida, Converter={StaticResource InverseBoolToVis}}">
                                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoTrash}" Width="14" Height="14" Stroke="{DynamicResource SubBrush}" />
                                                    </Button>
                                                    <Button DockPanel.Dock="Right" Command="{Binding DataContext.EditMessageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Id}"
                                                            Style="{StaticResource GhostButton}" Padding="8" BorderThickness="0" Background="Transparent"
                                                            Visibility="{Binding EsPredefinida, Converter={StaticResource InverseBoolToVis}}">
                                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSettings}" Width="14" Height="14" Stroke="{DynamicResource SubBrush}" />
                                                    </Button>
                                                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Habilitada, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                              ToolTip="Habilitada" />

                                                    <TextBlock Text="{Binding Texto}" FontSize="12" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" TextWrapping="Wrap"
                                                               Opacity="{Binding Habilitada, Converter={StaticResource BoolToOpacity}}" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
            </DockPanel>

            <!-- ===================== MODAL: Ajustes / Licencia ===================== -->
            <!-- Fondo oscurecido + panel centrado, embebido en la ventana en vez de una
                 ventana de Windows aparte (estilo "modal" tipo Postman). -->
            <Border Background="{DynamicResource OverlayBrush}"
                    Visibility="{Binding IsSettingsModalOpen, Converter={StaticResource BoolToVis}}"
                    MouseLeftButtonDown="OnCloseSettingsModalBackdropClick">
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                        MouseLeftButtonDown="OnStopClickPropagation">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.28" Color="#000000" />
                    </Border.Effect>
                    <Grid>
                        <c:AjustesPanel DataContext="{Binding AjustesModal}" />
                        <Button Style="{StaticResource TitleBarButton}" Width="30" Height="26"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-16,-16,0"
                                Command="{Binding CloseSettingsModalCommand}" ToolTip="Cerrar">
                            <Button.Content>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,0" EndPoint="10,10" />
                                    <LineGeometry StartPoint="10,0" EndPoint="0,10" />
                                </GeometryGroup>
                            </Button.Content>
                        </Button>
                    </Grid>
                </Border>
            </Border>

            <Border Background="{DynamicResource OverlayBrush}"
                    Visibility="{Binding IsLicenseModalOpen, Converter={StaticResource BoolToVis}}"
                    MouseLeftButtonDown="OnCloseLicenseModalBackdropClick">
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="14" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="OnStopClickPropagation">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.28" Color="#000000" />
                    </Border.Effect>
                    <StackPanel Margin="28,26,28,22">
                        <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoAward}" Width="20" Height="20"
                                  Stroke="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Activar Premium" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource InkBrush}" Margin="0,16,0,6" />
                        <TextBlock Text="{Binding LicenciaModalEstado}" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubBrush}" LineHeight="18" Margin="0,0,0,14" />

                        <TextBlock Text="Clave de licencia" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding LicenciaModalClave, UpdateSourceTrigger=PropertyChanged}" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontSize="11"
                                 Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource InkBrush}"
                                 BorderBrush="{DynamicResource CardBorderBrush}" Padding="8" />

                        <TextBlock Text="La clave no es válida." FontSize="11" Foreground="#EF4444" Margin="0,6,0,0"
                                   Visibility="{Binding LicenciaModalErrorVisible, Converter={StaticResource BoolToVis}}" />

                        <DockPanel Margin="0,20,0,0">
                            <Button Content="Cerrar" Style="{StaticResource GhostButton}" Command="{Binding CerrarLicenciaModalCommand}" DockPanel.Dock="Left" MinWidth="90" />
                            <Button Content="Activar" Style="{StaticResource PrimaryButton}" Command="{Binding ActivarLicenciaCommand}"
                                    HorizontalAlignment="Right" MinWidth="100" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Border>
            </Grid>
        </Border>
        </Border>
    </Grid>
</Window>


