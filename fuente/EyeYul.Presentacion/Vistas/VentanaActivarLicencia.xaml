<Window x:Class="EyeYul.Presentacion.Vistas.VentanaActivarLicencia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EyeYul" Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{DynamicResource SansFont}" TextOptions.TextFormattingMode="Display">
    <!-- Sombra en un Border vacío detrás del contenido (ver VentanaPrincipal.xaml). -->
    <Grid>
        <Border CornerRadius="16" Background="{DynamicResource PanelBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.22" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="16" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" MouseLeftButtonDown="OnDragMove">
        <StackPanel Margin="28,26,28,22">
            <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                <Path Style="{StaticResource Ico}" Data="{StaticResource IcoAward}" Width="20" Height="20"
                      Stroke="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Activar Premium" FontSize="15" FontWeight="Bold"
                       Foreground="{DynamicResource InkBrush}" Margin="0,16,0,6" />
            <TextBlock x:Name="EstadoText" Text="" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource SubBrush}" LineHeight="18" Margin="0,0,0,14" />

            <TextBlock Text="Clave de licencia" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6" />
            <TextBox x:Name="ClaveTextBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontSize="11"
                     Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource InkBrush}"
                     BorderBrush="{DynamicResource CardBorderBrush}" Padding="8" />

            <TextBlock x:Name="ErrorText" Text="La clave no es válida." FontSize="11" Foreground="#EF4444"
                       Margin="0,6,0,0" Visibility="Collapsed" />

            <DockPanel Margin="0,20,0,0">
                <Button Content="Cerrar" Style="{StaticResource GhostButton}" Click="OnCerrarClick" DockPanel.Dock="Left" MinWidth="90" />
                <Button Content="Activar" Style="{StaticResource PrimaryButton}" Click="OnActivarClick"
                        HorizontalAlignment="Right" MinWidth="100" />
            </DockPanel>
        </StackPanel>
        </Border>
    </Grid>
</Window>
