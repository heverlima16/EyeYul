<Window x:Class="EyeYul.Presentacion.Vistas.VentanaPantallaDescanso"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Topmost="True" Background="Transparent"
        Title="EyeYul — Pausa">
    <!-- Fondo con blur Acrylic en vivo (ver DesenfoqueVentana) en vez del degradado solido de
         antes: el tinte semitransparente de este Grid es lo unico que garantiza que el texto
         siga siendo legible sobre cualquier cosa que haya detras. -->
    <Grid x:Name="Root" Background="#59000000">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720">
            <Image Source="{StaticResource EyeLogo}" Width="96" Height="96"
                   HorizontalAlignment="Center" Opacity="0.95" />

            <TextBlock x:Name="MessageText" Text="Descansa la vista."
                       Foreground="White" FontSize="34" FontWeight="Light"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,28,0,0" />

            <TextBlock x:Name="CountdownText" Text="00:20"
                       Foreground="White" FontSize="88" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,24,0,0" />

            <Button x:Name="SkipButton" Content="Omitir pausa" Click="OnSkip"
                    Foreground="White" Background="#33FFFFFF" BorderThickness="0"
                    Padding="20,10" FontSize="15" Cursor="Hand"
                    HorizontalAlignment="Center" Margin="0,36,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>

