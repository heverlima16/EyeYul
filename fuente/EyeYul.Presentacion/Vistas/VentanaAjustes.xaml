<Window x:Class="EyeYul.Presentacion.Vistas.VentanaAjustes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:EyeYul.Presentacion.Controles"
        Title="EyeYul — Ajustes" Width="520" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CreamBrush}"
        FontFamily="Segoe UI" ResizeMode="CanMinimize" TextOptions.TextFormattingMode="Display">
    <!-- Ventana flotante independiente: unico camino accesible desde la bandeja cuando la
         ventana principal esta cerrada. El contenido en si vive en AjustesPanel, reusado
         tambien por el modal embebido de VentanaPrincipal. -->
    <c:AjustesPanel Margin="24" />
</Window>
