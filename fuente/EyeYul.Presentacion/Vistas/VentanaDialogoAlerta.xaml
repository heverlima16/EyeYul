<Window x:Class="EyeYul.Presentacion.Vistas.VentanaDialogoAlerta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EyeYul" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{DynamicResource SansFont}">
    <!-- Sombra en un Border vacío detrás del contenido (ver VentanaPrincipal.xaml). -->
    <Grid>
        <Border CornerRadius="16" Background="{DynamicResource PanelBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.22" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="16" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" MouseLeftButtonDown="OnDragMove">
        <StackPanel Margin="28,26,28,22">
            <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                <Path x:Name="Icono" Style="{StaticResource Ico}" Data="{StaticResource IcoBell}" Width="20" Height="20"
                      Stroke="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="TituloText" Text="EyeYul" FontSize="15" FontWeight="Bold"
                       Foreground="{DynamicResource InkBrush}" Margin="0,16,0,6" />
            <TextBlock x:Name="MensajeText" Text="" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource SubBrush}" LineHeight="18" />
            <Button Content="Entendido" Style="{StaticResource PrimaryButton}" Click="OnAceptarClick"
                    HorizontalAlignment="Right" Margin="0,22,0,0" MinWidth="100" />
        </StackPanel>
        </Border>
    </Grid>
</Window>
