<Window x:Class="EyeYul.Presentacion.Vistas.VentanaAccionSaludable"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EyeYul"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" MouseLeftButtonDown="OnClick"
        FontFamily="{StaticResource SansFont}">
    <!-- Fondo con blur Acrylic en vivo a pantalla completa (ver DesenfoqueVentana), igual que
         la pausa: el tinte semitransparente de este Grid es lo unico que garantiza que el
         mensaje siga siendo legible sobre cualquier cosa que haya detras. -->
    <Grid Background="#22000000">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720">
            <Grid Width="110" Height="110" HorizontalAlignment="Center">
                <!-- Postura: rebota hacia arriba, como "enderezate". -->
                <Path x:Name="IconoPostura" Data="{StaticResource IcoChevronsUp}" Stroke="White" StrokeThickness="2.2"
                      Width="80" Height="80" Stretch="Uniform" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="TransPostura" />
                        </TransformGroup>
                    </Path.RenderTransform>
                </Path>

                <!-- Parpadeo: el ojo se achica en el eje Y, como un parpadeo. -->
                <Path x:Name="IconoParpadeo" Data="{StaticResource IcoEye}" Stroke="White" StrokeThickness="2"
                      Width="80" Height="80" Stretch="Uniform" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ScalaParpadeo" ScaleX="1" ScaleY="1" />
                        </TransformGroup>
                    </Path.RenderTransform>
                </Path>

                <!-- Hidratacion: la gota "cae" con un rebote suave. -->
                <Path x:Name="IconoHidratacion" Data="{StaticResource IcoDroplet}" Stroke="White" StrokeThickness="2"
                      Width="70" Height="70" Stretch="Uniform" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="TransHidratacion" />
                        </TransformGroup>
                    </Path.RenderTransform>
                </Path>

                <!-- Estiramiento: la figura se inclina de lado a lado, como estirando. -->
                <Path x:Name="IconoEstiramiento" Data="{StaticResource IcoEstirar}" Stroke="White" StrokeThickness="2"
                      Width="80" Height="80" Stretch="Uniform" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="RotaEstiramiento" Angle="0" />
                        </TransformGroup>
                    </Path.RenderTransform>
                </Path>
            </Grid>

            <TextBlock x:Name="TituloText" FontWeight="Bold" FontSize="34" Foreground="White"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,28,0,0" />

            <TextBlock x:Name="MensajeText" FontSize="18" FontWeight="Light" Foreground="#DDFFFFFF"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </Grid>
</Window>
