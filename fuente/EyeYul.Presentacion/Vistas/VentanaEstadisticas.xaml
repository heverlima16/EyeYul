<Window x:Class="EyeYul.Presentacion.Vistas.VentanaEstadisticas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:comp="clr-namespace:EyeYul.Presentacion.Componentes"
        Title="EyeYul — Estadísticas" Width="520" Height="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CreamBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,20">
            <Image Source="{StaticResource EyeLogo}" Width="40" Height="40" />
            <TextBlock Text="Hoy" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <!-- Tarjeta Screen Score -->
        <comp:TarjetaBase Grid.Row="1" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Screen Score" FontSize="13" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="{Binding Puntaje}" FontSize="64" FontWeight="Bold" Foreground="{DynamicResource TerracottaBrush}" />
                    <TextBlock Text="{Binding Calificacion}" FontSize="15" Foreground="{DynamicResource InkBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding DescansosTomados, StringFormat=Pausas: {0}}" Foreground="{DynamicResource InkBrush}" FontSize="15" Margin="0,2" />
                    <TextBlock Text="{Binding DescansosOmitidos, StringFormat=Omitidas: {0}}" Foreground="{DynamicResource MutedBrush}" FontSize="15" Margin="0,2" />
                    <TextBlock Text="{Binding TiempoActivo, StringFormat=Activo: {0}}" Foreground="{DynamicResource MutedBrush}" FontSize="15" Margin="0,2" />
                </StackPanel>
            </Grid>
        </comp:TarjetaBase>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <comp:TarjetaBase Grid.Column="0">
                <DockPanel>
                    <comp:EtiquetaTitulo DockPanel.Dock="Top" Texto="Apps" />
                    <ItemsControl ItemsSource="{Binding AppsPrincipales}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,5">
                                    <TextBlock Text="{Binding Tiempo}" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock Text="{Binding Nombre}" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </comp:TarjetaBase>

            <comp:TarjetaBase Grid.Column="2">
                <DockPanel>
                    <comp:EtiquetaTitulo DockPanel.Dock="Top" Texto="Sitios" />
                    <ItemsControl ItemsSource="{Binding SitiosPrincipales}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,5">
                                    <TextBlock Text="{Binding Tiempo}" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock Text="{Binding Nombre}" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </comp:TarjetaBase>
        </Grid>
    </Grid>
</Window>

