<Window x:Class="EyeYul.Presentacion.Vistas.VentanaNotificacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        SizeToContent="WidthAndHeight" Title="EyeYul">
    <!-- Sombra en un Border vacío detrás del contenido (ver VentanaPrincipal.xaml). -->
    <Grid>
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.22" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="18"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel Width="320">
            <StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource EyeLogo}" Width="28" Height="28" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" Text="EyeYul" FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock x:Name="BodyText" Text="" Foreground="{DynamicResource MutedBrush}"
                       FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" />

            <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Ahora" Style="{StaticResource PrimaryButton}" Click="OnNow" />
                <Button Content="+1" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnSnooze1" />
                <Button Content="+5" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnSnooze5" />
                <Button Content="+15" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnSnooze15" />
                <Button Content="Omitir" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnSkip" />
            </StackPanel>
        </StackPanel>
        </Border>
    </Grid>
</Window>

